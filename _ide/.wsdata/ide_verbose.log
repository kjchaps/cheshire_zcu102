      "text": "void write_labeled_test_array_1D_fp_to_mem_and_txt(UINTPTR base_addr,\n                                                   uint32_t length,\n                                                   uint32_t mode,\n                                                   uint32_t width,\n                                                   uint32_t stride,\n                                                   const char *file_stem,\n                                                   char array_name)\n{\n    uint32_t i;\n    uint32_t elem_size = width / 8;\n    uint8_t *base = (uint8_t *)base_addr;\n    char out_name[64];\n    char line[128];\n    u32 name_i = 0;\n    int Status;\n    FIL *fp = 0;\n    UINT bytes_written;\n\n    if ((elem_size != 4U) && (elem_size != 8U)) {\n        xil_printf(\"Unsupported FP width: %lu\\r\\n\", (unsigned long)width);\n        return;\n    }\n\n    if (stride == 0U) {\n        stride = elem_size;\n    }\n\n    /* Build filename: <basename>.txt */\n    if (file_stem == 0 || file_stem[0] == 0) {\n        strcpy(out_name, \"memdump.txt\");\n    } else {\n        while (file_stem[name_i] != 0 &&\n               file_stem[name_i] != '.' &&\n               name_i < (sizeof(out_name) - sizeof(\".txt\"))) {\n            out_name[name_i] = file_stem[name_i];\n            name_i++;\n        }\n        out_name[name_i] = 0;\n\n        if (name_i == 0) {\n            strcpy(out_name, \"memdump.txt\");\n        } else {\n            strcpy(&out_name[name_i], \".txt\");\n        }\n    }\n\n    if (array_name == 0) {\n        array_name = 'a';\n    }\n\n    xil_printf(\"Generating FP array: base=0x%08lx len=%lu width=%lu stride=%lu label=\\r\\n\",\n               (unsigned long)base_addr,\n               (unsigned long)length,\n               (unsigned long)width,\n               (unsigned long)stride,\n               array_name);\n\n    Status = SD_Init();\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD card init failed\\r\\n\");\n        return;\n    }\n    xil_printf(\"SD_Init OK\\r\\n\");\n\n    fp = openFile(out_name, 'w');\n    if (fp == 0) {\n        xil_printf(\"File opening failed\\r\\n\");\n        SD_Eject();\n        return;\n    }\n    xil_printf(\"openFile write OK (%s)\\r\\n\", out_name);\n\n    snprintf(line, sizeof(line), \"%c = [\\r\\n\", array_name);\n    f_write(fp, line, strlen(line), &bytes_written);\n\n    for (i = 0; i < length; i++) {\n        uint8_t *ptr = base + (i * stride);\n\n        if (elem_size == 4U) {\n            float value = 0.0f;\n\n            if (mode == WRITE_RAND) {\n                value = (float)rand() / (float)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0f;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n\n            if (i < (length - 1U)) {\n                snprintf(line, sizeof(line), \"  %.8f,\\r\\n\", value);\n            } else {\n                snprintf(line, sizeof(line), \"  %.8f\\r\\n\", value);\n            }\n\n            f_write(fp, line, strlen(line), &bytes_written);\n        } else {\n            double value = 0.0;\n\n            if (mode == WRITE_RAND) {\n                value = (double)rand() / (double)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n\n            if (i < (length - 1U)) {\n                snprintf(line, sizeof(line), \"  %.16lf,\\r\\n\", value);\n            } else {\n                snprintf(line, sizeof(line), \"  %.16lf\\r\\n\", value);\n            }\n\n            f_write(fp, line, strlen(line), &bytes_written);\n        }\n    }\n\n    snprintf(line, sizeof(line), \"]\\r\\n\");\n    f_write(fp, line, strlen(line), &bytes_written);\n\n    Xil_DCacheFlushRange((INTPTR)base_addr, (u32)(length * stride));\n\n    Status = (int)closeFile(fp);\n    if (Status == XST_FAILURE) {\n        xil_printf(\"closeFile failed\\r\\n\");\n    } else {\n        xil_printf(\"closeFile OK\\r\\n\");\n    }\n\n    Status = SD_Eject();\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD_Eject failed\\r\\n\");\n    } else {\n        xil_printf(\"SD_Eject OK, safe to remove SD card\\r\\n\");\n    }\n}",
