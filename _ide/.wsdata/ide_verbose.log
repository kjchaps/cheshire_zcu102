      "rangeLength": 2621,
      "text": "void write_labeled_test_array_1D_fp_to_mem_and_txt(UINTPTR base_addr,\n                                                   uint32_t length,\n                                                   uint32_t mode,\n                                                   uint32_t width,\n                                                   uint32_t stride,\n                                                   const char *file_stem,\n                                                   char array_name)\n{\n    uint32_t i;\n    uint32_t elem_size = width / 8;\n    uint8_t *base = (uint8_t *)base_addr;\n    char out_name[64];\n    char line[64];\n    u32 name_i = 0;\n    FIL *fp = 0;\n    UINT bytes_written;\n\n    if ((elem_size != 4U) && (elem_size != 8U)) {\n        return;\n    }\n\n    if (stride == 0U) {\n        stride = elem_size;\n    }\n\n    if (file_stem == 0 || file_stem[0] == 0) {\n        strcpy(out_name, \"memdump.txt\");\n    } else {\n        while (file_stem[name_i] != 0 &&\n               file_stem[name_i] != '.' &&\n               name_i < (sizeof(out_name) - 5U)) {\n            out_name[name_i] = file_stem[name_i];\n            name_i++;\n        }\n        out_name[name_i] = 0;\n        strcat(out_name, \".txt\");\n    }\n\n    if (SD_Init() == XST_FAILURE) {\n        return;\n    }\n\n    fp = openFile(out_name, 'a');\n    if (fp == 0) {\n        SD_Eject();\n        return;\n    }\n\n    line[0] = array_name;\n    line[1] = ':';\n    line[2] = '\\r';\n    line[3] = '\\n';\n    line[4] = 0;\n    f_write(fp, line, strlen(line), &bytes_written);\n\n    for (i = 0; i < length; i++) {\n        uint8_t *ptr = base + (i * stride);\n\n        if (elem_size == 4U) {\n            float value = 0.0f;\n            uint32_t bits;\n\n            if (mode == WRITE_RAND) {\n                value = (float)rand() / (float)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0f;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n            memcpy(&bits, &value, sizeof(bits));\n\n            sprintf(line, \"%08lx\\r\\n\", (unsigned long)bits);\n            f_write(fp, line, strlen(line), &bytes_written);\n        } else {\n            double value = 0.0;\n            uint64_t bits;\n\n            if (mode == WRITE_RAND) {\n                value = (double)rand() / (double)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n            memcpy(&bits, &value, sizeof(bits));\n\n            sprintf(line, \"%016llx\\r\\n\", (unsigned long long)bits);\n            f_write(fp, line, strlen(line), &bytes_written);\n        }\n    }\n\n    closeFile(fp);\n    SD_Eject();\n}",
      "rangeOffset": 32080,
      "forceMoveMarkers": false
    }
