  'file:///home3/shared/chapman44/cheshire/app_component/sdCard_new.c'
].txt\", file_stem);\n        fp = fopen(filename, \"w\");\n    }\n\n    if (fp != NULL && array_name != NULL) {\n        fprintf(fp, \"%s = [\\n\", array_name);\n    }\n\n    for (i = 0; i < length; i++) {\n        uint8_t *ptr = base + i * stride;\n\n        switch (elem_size) {\n            case 4: {\n                float value = 0.0f;\n\n                if (mode == WRITE_RAND) {\n                    value = (float)rand() / (float)RAND_MAX;\n                } else if (mode == WRITE_ONES) {\n                    value = 1.0f;\n                }\n\n                memcpy(ptr, &value, sizeof(value));\n\n                if (fp != NULL) {\n                    fprintf(fp, \"  %.8f\", value);\n                    if (i < length - 1) {\n                        fprintf(fp, \",\");\n                    }\n                    fprintf(fp, \"\\n\");\n                }\n                break;\n            }\n\n            case 8: {\n                double value = 0.0;\n\n                if (mode == WRITE_RAND) {\n                    value = (double)rand() / (double)RAND_MAX;\n                } else if (mode == WRITE_ONES) {\n                    value = 1.0;\n                }\n\n                memcpy(ptr, &value, sizeof(value));\n\n                if (fp != NULL) {\n                    fprintf(fp, \"  %.16lf\", value);\n                    if (i < length - 1) {\n                        fprintf(fp, \",\");\n                    }\n                    fprintf(fp, \"\\n\");\n                }\n                break;\n            }\n\n            default:\n                break;\n        }\n    }\n\n    if (fp != NULL) {\n        if (array_name != NULL) {\n            fprintf(fp, \"]\\n\");\n        }\n        fclose(fp);\n    }\n}",
