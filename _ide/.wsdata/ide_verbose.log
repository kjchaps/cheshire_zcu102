2026-05-08 11:21:15 [debug] : ending navigation with location {"uri":"file:///home3/shared/chapman44/cheshire/app_component/sdCard_new.c","type":2,"context":{"range":{"start":{"line":1167,"character":0},"end":{"line":1167,"character":0}},"rangeLength":0,"text":"int write_test_array_1D_fp_to_mem_and_bin(UINTPTR base_addr,\n                                          uint32_t length,\n                                          uint32_t mode,\n                                          uint32_t width,\n                                          uint32_t stride,\n                                          const char *input_name)\n{\n    uint32_t i;\n    uint32_t elem_size = width / 8;\n    uint32_t total_bytes;\n    uint8_t *base = (uint8_t *)base_addr;\n    char out_name[64];\n    u32 name_i = 0;\n    int Status;\n    FIL *fp = 0;\n\n    if ((elem_size != 4U) && (elem_size != 8U)) {\n        xil_printf(\"Unsupported FP width: %lu\\r\\n\", (unsigned long)width);\n        return XST_FAILURE;\n    }\n\n    if (stride == 0U) {\n        stride = elem_size;\n    }\n\n    total_bytes = length * elem_size;\n\n    /* Build filename: <basename>_dump.bin */\n    if (input_name == 0 || input_name[0] == 0) {\n        strcpy(out_name, \"memdump_dump.bin\");\n    } else {\n        while (input_name[name_i] != 0 &&\n               input_name[name_i] != '.' &&\n               name_i < (sizeof(out_name) - sizeof(\"_dump.bin\"))) {\n            out_name[name_i] = input_name[name_i];\n            name_i++;\n        }\n        out_name[name_i] = 0;\n\n        if (name_i == 0) {\n            strcpy(out_name, \"memdump_dump.bin\");\n        } else {\n            strcpy(&out_name[name_i], \"_dump.bin\");\n        }\n    }\n\n    xil_printf(\"Generating FP array: base=0x%08lx len=%lu width=%lu stride=%lu\\r\\n\",\n               (unsigned long)base_addr,\n               (unsigned long)length,\n               (unsigned long)width,\n               (unsigned long)stride);\n\n    for (i = 0; i < length; i++) {\n        uint8_t *ptr = base + (i * stride);\n\n        if (elem_size == 4U) {\n            float value = 0.0f;\n\n            if (mode == WRITE_RAND) {\n                value = (float)rand() / (float)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0f;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n        } else {\n            double value = 0.0;\n\n            if (mode == WRITE_RAND) {\n                value = (double)rand() / (double)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n        }\n    }\n\n    Xil_DCacheFlushRange((INTPTR)base_addr, (u32)(length * stride));\n\n    Status = SD_Init();\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD card init failed\\r\\n\");\n        return XST_FAILURE;\n    }\n    xil_printf(\"SD_Init OK\\r\\n\");\n\n    fp = openFile(out_name, 'w');\n    if (fp == 0) {\n        xil_printf(\"File opening failed\\r\\n\");\n        SD_Eject();\n        return XST_FAILURE;\n    }\n    xil_printf(\"openFile write OK ([])\\r\\n\", out_name);\n\n    Status = writeFile(fp, total_bytes, (u32)(uintptr_t)base_addr);\n    if (Status == XST_FAILURE) {\n        xil_printf(\"writeFile failed\\r\\n\");\n        closeFile(fp);\n        SD_Eject();\n        return XST_FAILURE;\n    }\n    xil_printf(\"writeFile OK\\r\\n\");\n\n    Status = (int)closeFile(fp);\n    if (Status == XST_FAILURE) {\n        xil_printf(\"closeFile failed\\r\\n\");\n        SD_Eject();\n        return XST_FAILURE;\n    }\n    xil_printf(\"closeFile OK\\r\\n\");\n\n    Status = SD_Eject();\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD_Eject failed\\r\\n\");\n        return XST_FAILURE;\n    }\n    xil_printf(\"SD_Eject OK, safe to remove SD card\\r\\n\");\n\n    return XST_SUCCESS;\n}"}} 
