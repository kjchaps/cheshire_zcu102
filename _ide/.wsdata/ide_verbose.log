      "rangeLength": 2622,
      "text": "void write_labeled_test_array_1D_fp_to_mem_and_txt(UINTPTR base_addr,\n                                                   uint32_t length,\n                                                   uint32_t mode,\n                                                   uint32_t width,\n                                                   uint32_t stride,\n                                                   const char *file_stem,\n                                                   char array_name)\n{\n    uint32_t i;\n    uint32_t elem_size = width / 8;\n    uint8_t *base = (uint8_t *)base_addr;\n\n    char out_name[64];\n    char line[64];\n\n    u32 name_i = 0;\n    int Status;\n\n    FIL *fp = 0;\n    UINT bytes_written;\n\n    if ((elem_size != 4U) && (elem_size != 8U)) {\n        xil_printf(\"Unsupported FP width\\r\\n\");\n        return;\n    }\n\n    if (stride == 0U) {\n        stride = elem_size;\n    }\n\n    /* filename */\n    if (file_stem == 0 || file_stem[0] == 0) {\n        strcpy(out_name, \"memdump.txt\");\n    } else {\n\n        while (file_stem[name_i] != 0 &&\n               file_stem[name_i] != '.' &&\n               name_i < (sizeof(out_name) - 5U)) {\n\n            out_name[name_i] = file_stem[name_i];\n            name_i++;\n        }\n\n        out_name[name_i] = 0;\n        strcat(out_name, \".txt\");\n    }\n\n    Status = SD_Init();\n\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD init failed\\r\\n\");\n        return;\n    }\n\n    fp = openFile(out_name, 'a');\n\n    if (fp == 0) {\n        xil_printf(\"File open failed\\r\\n\");\n        SD_Eject();\n        return;\n    }\n\n    /* label */\n    line[0] = array_name;\n    line[1] = ':';\n    line[2] = '\\r';\n    line[3] = '\\n';\n    line[4] = 0;\n\n    f_write(fp, line, strlen(line), &bytes_written);\n\n    /* generate + write */\n    for (i = 0; i < length; i++) {\n\n        uint8_t *ptr = base + (i * stride);\n\n        if (elem_size == 4U) {\n\n            float value = 0.0f;\n            uint32_t hex;\n\n            if (mode == WRITE_RAND) {\n                value = (float)rand() / (float)RAND_MAX;\n            }\n            else if (mode == WRITE_ONES) {\n                value = 1.0f;\n            }\n\n            memcpy(ptr, &value, sizeof(float));\n            memcpy(&hex, &value, sizeof(uint32_t));\n\n            /* HEX line */\n            sprintf(line, \"%08X\\r\\n\", (unsigned int)hex);\n\n            f_write(fp,\n                    line,\n                    strlen(line),\n                    &bytes_written);\n        }\n        else {\n\n            double value = 0.0;\n            uint64_t hex;\n\n            uint32_t upper;\n            uint32_t lower;\n\n            if (mode == WRITE_RAND) {\n                value = (double)rand() / (double)RAND_MAX;\n            }\n            else if (mode == WRITE_ONES) {\n                value = 1.0;\n            }\n\n            memcpy(ptr, &value, sizeof(double));\n            memcpy(&hex, &value, sizeof(uint64_t));\n\n            upper = (uint32_t)(hex >> 32);\n            lower = (uint32_t)(hex & 0xFFFFFFFFU);\n\n            sprintf(line,\n                    \"%08X%08X\\r\\n\",\n                    (unsigned int)upper,\n                    (unsigned int)lower);\n\n            f_write(fp,\n                    line,\n                    strlen(line),\n                    &bytes_written);\n        }\n    }\n\n    Xil_DCacheFlushRange((INTPTR)base_addr,\n                         (u32)(length * stride));\n\n    closeFile(fp);\n\n    SD_Eject();\n}",
      "rangeOffset": 32080,
      "forceMoveMarkers": false
    }
  ],
  "eol": "\n",
