      "rangeLength": 2620,
      "text": "void write_labeled_test_array_1D_fp_to_mem_and_txt(UINTPTR base_addr,\n                                                   uint32_t length,\n                                                   uint32_t mode,\n                                                   uint32_t width,\n                                                   uint32_t stride,\n                                                   const char *file_stem,\n                                                   char array_name)\n{\n    uint32_t i;\n    uint32_t elem_size = width / 8;\n    uint8_t *base = (uint8_t *)base_addr;\n    char out_name[64];\n    char line[128];\n    u32 name_i = 0;\n    int Status;\n    FIL *fp = 0;\n    UINT bytes_written;\n\n    if ((elem_size != 4U) && (elem_size != 8U)) {\n        xil_printf(\"Unsupported FP width: %lu\\r\\n\", (unsigned long)width);\n        return;\n    }\n\n    if (stride == 0U) {\n        stride = elem_size;\n    }\n\n    /* Build output filename */\n    if (file_stem == 0 || file_stem[0] == 0) {\n        strcpy(out_name, \"memdump.txt\");\n    } else {\n        while (file_stem[name_i] != 0 &&\n               file_stem[name_i] != '.' &&\n               name_i < (sizeof(out_name) - sizeof(\".txt\") - 1U)) {\n            out_name[name_i] = file_stem[name_i];\n            name_i++;\n        }\n\n        out_name[name_i] = 0;\n\n        if (name_i == 0U) {\n            strcpy(out_name, \"memdump.txt\");\n        } else {\n            strcat(out_name, \".txt\");\n        }\n    }\n\n    /* Init SD */\n    Status = SD_Init();\n    if (Status == XST_FAILURE) {\n        xil_printf(\"SD card init failed\\r\\n\");\n        return;\n    }\n\n    /* Open file */\n    fp = openFile(out_name, 'a');\n    if (fp == 0) {\n        xil_printf(\"File opening failed\\r\\n\");\n        SD_Eject();\n        return;\n    }\n\n    /* Write label */\n    snprintf(line, sizeof(line), \":\\r\\n\", array_name);\n    f_write(fp, line, strlen(line), &bytes_written);\n\n    /* Generate values, write to memory, AND log HEX to SD */\n    for (i = 0; i < length; i++) {\n\n        uint8_t *ptr = base + (i * stride);\n\n        if (elem_size == 4U) {\n\n            float value = 0.0f;\n            uint32_t hex_value;\n\n            if (mode == WRITE_RAND) {\n                value = (float)rand() / (float)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0f;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n            memcpy(&hex_value, &value, sizeof(hex_value));\n\n            /* Write hex representation */\n            snprintf(line, sizeof(line),\n                     \"0x%08lX\\r\\n\",\n                     (unsigned long)hex_value);\n\n            f_write(fp, line, strlen(line), &bytes_written);\n\n        } else {\n\n            double value = 0.0;\n            uint64_t hex_value;\n\n            if (mode == WRITE_RAND) {\n                value = (double)rand() / (double)RAND_MAX;\n            } else if (mode == WRITE_ONES) {\n                value = 1.0;\n            }\n\n            memcpy(ptr, &value, sizeof(value));\n            memcpy(&hex_value, &value, sizeof(hex_value));\n\n            /* Write hex representation */\n            snprintf(line, sizeof(line),\n                     \"0x%08lX%08lX\\r\\n\",\n                     (unsigned long)(hex_value >> 32),\n                     (unsigned long)(hex_value & 0xFFFFFFFFULL));\n\n            f_write(fp, line, strlen(line), &bytes_written);\n        }\n    }\n\n    /* Flush cache */\n    Xil_DCacheFlushRange((INTPTR)base_addr,\n                         (u32)(length * stride));\n\n    closeFile(fp);\n    SD_Eject();\n}",
      "rangeOffset": 32081,
      "forceMoveMarkers": false
    }
  ],
  "eol": "\n",
  "isEolChange": false,
